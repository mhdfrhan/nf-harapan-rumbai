APP_NAME="Sistem NF Harapan Rumbai"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://sistem.example.com
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=id

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nf_harapan_rumbai
DB_USERNAME=nf_harapan_app
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

STORE_NAME="Toko NF Harapan Rumbai"
STORE_ADDRESS="Jl. Harapan, Lembah Sari, Rumbai, Kota Pekanbaru, Riau 28266"
STORE_TIMEZONE=Asia/Jakarta
STORE_CURRENCY=IDR
STORE_ALLOW_NEGATIVE_STOCK=false
STORE_DOCUMENT_MAX_KILOBYTES=8192
STORE_DOCUMENT_MAX_FILES=5
STORE_DOCUMENT_MAX_IMAGE_PIXELS=24000000

SEED_OWNER_PASSWORD=
VITE_APP_NAME="${APP_NAME}"
