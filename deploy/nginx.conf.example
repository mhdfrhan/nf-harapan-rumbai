server {
    listen 80;
    listen [::]:80;
    server_name sistem.example.com;

    location /.well-known/acme-challenge/ { root /var/www/letsencrypt; }
    location / { return 301 https://sistem.example.com$request_uri; }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name sistem.example.com;
    server_tokens off;
    root /var/www/nf-harapan-rumbai/public;
    index index.php;

    client_max_body_size 9m;
    add_header X-Content-Type-Options nosniff always;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        try_files $uri =404;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT $realpath_root;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
        fastcgi_read_timeout 60s;
    }

    location ~ /\.(?!well-known).* { deny all; }
    location ~* \.(?:env|log|sql|sqlite|bak)$ { deny all; }

    ssl_certificate /etc/letsencrypt/live/sistem.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/sistem.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
}
